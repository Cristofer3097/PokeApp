@model IEnumerable<PokeApp.Models.Pokemon>

    @{
    ViewData["Title"] = "Pokémon List";
    }

    <h1>Pokémon List</h1>

    <form asp-action="Index" method="get">
        <div class="form-group">
            <label for="nameFilter">Filtrar por Nombre:</label>
            <input type="text" name="nameFilter" class="form-control" value="@ViewBag.NameFilter" />
        </div>
        <div class="form-group">
            <label for="speciesFilter">Filtrar por Especie:</label>
            <select name="speciesFilter" class="form-control" asp-items="@ViewBag.PokemonTypes">
                <option value="all">Todas</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <button type="button" class="btn btn-secondary" onclick="clearFilters()">Limpiar Filtros</button>
    </form>

    <hr />

    <form asp-action="ExportToExcel" method="post">
        <input type="hidden" name="nameFilter" value="@ViewBag.NameFilter" />
        <input type="hidden" name="speciesFilter" value="@ViewBag.SpeciesFilter" />
        <button type="submit" class="btn btn-success">Exportar a Excel</button>
    </form>

    <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#sendEmailModal">Enviar Correo</button>

    <table class="table">
        <thead>
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Especie</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pokemon in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(pokemon.Sprites?.FrontDefault))
                    {
                    <img src="@pokemon.Sprites.FrontDefault" alt="@pokemon.Name" width="50" height="50" />
                    }
                </td>
                <td>@pokemon.Name</td>
                <td>@string.Join(", ", pokemon.Types.Select(t => t.Type.Name))</td>
                <td>
                    <button type="button" class="btn btn-sm btn-info view-details" data-pokemon-name="@pokemon.Name">Detalles</button>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @{ // Bloque de C# para la paginación.
    var prevDisabled = ViewBag.CurrentPage <= 1 ? "disabled" : "";
    var nextDisabled = ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var maxPagesToShow = 10;
    var startPage = Math.Max(1, currentPage - (maxPagesToShow / 2));
    var endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

    if (endPage - startPage + 1 < maxPagesToShow)
    {
        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
    }
    }

    <nav aria-label="Page navigation example">
        <ul class="pagination">
            <li class="page-item @prevDisabled">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(currentPage - 1)"
                   asp-route-nameFilter="@ViewBag.NameFilter"
                   asp-route-speciesFilter="@ViewBag.SpeciesFilter">Anterior</a>
            </li>

            @if (startPage > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="1"
                   asp-route-nameFilter="@ViewBag.NameFilter"
                   asp-route-speciesFilter="@ViewBag.SpeciesFilter">1</a>
            </li>
            @if (startPage > 2)
            {
            <li class="page-item disabled"><span class="page-link">...</span></li>
            }
        }

            @for (int i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == currentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i"
                   asp-route-nameFilter="@ViewBag.NameFilter"
                   asp-route-speciesFilter="@ViewBag.SpeciesFilter">@i</a>
            </li>
        }

            @if (endPage < totalPages)
        {
            @if (endPage < totalPages - 1)
            {
            <li class="page-item disabled"><span class="page-link">...</span></li>
            }
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@totalPages"
                   asp-route-nameFilter="@ViewBag.NameFilter"
                   asp-route-speciesFilter="@ViewBag.SpeciesFilter">@totalPages</a>
            </li>
        }

            <li class="page-item @nextDisabled">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(currentPage + 1)"
                   asp-route-nameFilter="@ViewBag.NameFilter"
                   asp-route-speciesFilter="@ViewBag.SpeciesFilter">Siguiente</a>
            </li>
        </ul>
    </nav>

    <div class="modal fade" id="sendEmailModal" tabindex="-1" aria-labelledby="sendEmailModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="sendEmailModalLabel">Enviar Correo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="SendEmail" method="post">
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="emailAddress">Destinatario:</label>
                            <input type="email" class="form-control" name="emailAddress" required />
                        </div>
                        <div class="form-group">
                            <label for="subject">Asunto:</label>
                            <input type="text" class="form-control" name="subject" required />
                        </div>
                        <div class="form-group">
                            <label for="body">Cuerpo del Correo:</label>
                            <textarea class="form-control" name="body" rows="5"></textarea>
                        </div>
                       
                        <input type="hidden" name="pokemonName" id="emailPokemonName" />
                        <input type="hidden" name="pokemonId" id="emailPokemonId" />
                        <input type="hidden" name="pokemonTypes" id="emailPokemonTypes" />
                        <input type="hidden" name="pokemonImage" id="emailPokemonImage" />

                        <input type="hidden" name="nameFilter" value="@ViewBag.NameFilter" />
                        <input type="hidden" name="speciesFilter" value="@ViewBag.SpeciesFilter" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                        <button type="submit" class="btn btn-primary">Enviar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="pokemonDetailsModal" tabindex="-1" aria-labelledby="pokemonDetailsModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="pokemonDetailsModalLabel">Detalles del Pokémon</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="pokemonDetailsBody">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
        function clearFilters() {
            window.location.href = '@Url.Action("Index", "Pokemon")';
        }

        $(document).ready(function () {
            // ... (el código existente para 'view-details' se mantiene igual) ...
            $('.view-details').on('click', function () {
                var pokemonName = $(this).data('pokemon-name');
                $.ajax({
                    url: '@Url.Action("Details", "Pokemon")',
                    type: 'GET',
                    data: { name: pokemonName },
                    success: function (data) {
                        $('#pokemonDetailsBody').html(data);
                        $('#pokemonDetailsModal').modal('show');
                    },
                    error: function (xhr, status, error) {
                        console.error("Error al cargar detalles del Pokémon:", status, error);
                        alert("Error al cargar los detalles del Pokémon.");
                    }
                });
            });

            // --- NUEVO SCRIPT PARA MANEJAR EL ENVÍO DE DETALLES POR CORREO ---
            $(document).on('click', '#sendDetailsByEmailBtn', function () {
                var pokemonName = $(this).data('pokemon-name');
                var pokemonId = $(this).data('pokemon-id');
                var pokemonTypes = $(this).data('pokemon-types');
                var pokemonImage = $(this).data('pokemon-image');

                // 1. Poblar los campos ocultos en el formulario de correo
                $('#emailPokemonName').val(pokemonName);
                $('#emailPokemonId').val(pokemonId);
                $('#emailPokemonTypes').val(pokemonTypes);
                $('#emailPokemonImage').val(pokemonImage);

                // 2. Personalizar el título y el asunto del modal de correo
                $('#sendEmailModalLabel').text('Enviar Detalles de ' + pokemonName);
                $('#emailSubject').val('Detalles del Pokémon: ' + pokemonName);

                // 3. Cerrar el modal de detalles y abrir el de correo
                $('#pokemonDetailsModal').modal('hide');
                $('#sendEmailModal').modal('show');
            });

            // --- NUEVO SCRIPT PARA LIMPIAR EL MODAL DE CORREO AL CERRAR ---
            $('#sendEmailModal').on('hidden.bs.modal', function () {
                // Restablecer el formulario
                $(this).find('form')[0].reset();

                // Limpiar los campos ocultos
                $('#emailPokemonName').val('');
                $('#emailPokemonId').val('');
                $('#emailPokemonTypes').val('');
                $('#emailPokemonImage').val('');

                // Restablecer el título original del modal
                $('#sendEmailModalLabel').text('Enviar Correo');
            });
        });
        </script>
    }
